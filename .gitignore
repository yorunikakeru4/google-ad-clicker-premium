# --- project: worktrees, SQLite, Tauri/Node ---

# git worktree'ы фич (ветки feat/*), см. план.md §9.4
.worktrees/

# локальные данные юзера: креды прокси не должны попасть в git,
# запросы — его рабочий список, а не часть репозитория
proxies.txt
queries.txt

# SQLite: основной файл + WAL-объекты. WAL-файлы образуются рядом с базой
# при первом же подключении, поэтому игнорируются по маске, а не по имени
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Tauri / Node
node_modules/
ui/dist/
ui/target/
ui/src-tauri/target/
ui/gen/

# Python-шаблон выше игнорирует lib/ на ЛЮБОМ уровне, а у UI исходники лежат
# в ui/src/lib/ — исключаем именно её, иначе весь TS-код молча вне индекса
!ui/src/lib/

# движок
engine/logs/
engine/screenshots/
engine/profiles/

# Персистентные cookies профилей (фаза 6): внутри — сессионные креды
# аккаунтов, поэтому каталог локальных данных, а не часть репозитория
profile_data/
